# ============================================================
# FOODPULSE - ENVIRONMENT CONFIGURATION
# ============================================================

# -------------------------
# APPLICATION
# -------------------------
APP_NAME=FoodPulse
ENVIRONMENT=development
DEBUG=true

# -------------------------
# POSTGRESQL DATABASE
# -------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=foodpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/foodpulse

# -------------------------
# AUTHENTICATION / SECURITY
# -------------------------
SECRET_KEY=YOUR_GENERATED_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ============================================================
# SNOWFLAKE
# Enable these when the Snowflake module is implemented
# ============================================================

# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=FOODPULSE_WH
# SNOWFLAKE_DATABASE=FOODPULSE
# SNOWFLAKE_SCHEMA=ANALYTICS
# SNOWFLAKE_ROLE=


# ============================================================
# AIRFLOW
# Add Airflow connection configuration when implemented
# ============================================================

# AIRFLOW_UID=50000


# ============================================================
# OPTIONAL ML / NLP CONFIGURATION
# No external API keys are required for the planned local models
# ============================================================

ML_MODEL_DIR=./models
DATA_DIR=./data