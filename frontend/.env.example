# Frontend environment (Vite). Copy to frontend/.env — never commit real values.
# .env files are gitignored.

# Google Maps Demo Key for the Nearby restaurants page (/app/nearby).
# Read in the app as import.meta.env.VITE_GOOGLE_MAPS_API_KEY.
# Leave empty to show the missing-key state. Do not put a production/billable key here.
VITE_GOOGLE_MAPS_API_KEY=
